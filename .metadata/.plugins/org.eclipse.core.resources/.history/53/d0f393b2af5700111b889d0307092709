package platzi.play.plataforma;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.Iterator;
import java.util.List;

import platzi.play.contenido.Pelicula;

public class Plataforma {
	private String nombre;
	private List<Pelicula> contenido;
	
	public Plataforma(String nombre) {
		this.nombre = nombre;
		this.contenido = new ArrayList<Pelicula>();
	}
	
	public void agregar(Pelicula elemento) {
		this.contenido.add(elemento);
	}
	
	public List<String> getTitulos() {
//		for (int i = 0; i < contenido.size(); i++) {
//			System.out.println(contenido.get(i).getTitulo());
//		}
		
//		for (Pelicula pelicula : contenido) {
//			System.out.println(pelicula.getTitulo());
//		}
		
		return contenido
					    .stream()
					    .map(Pelicula::getTitulo)
					    .toList();
	}
	
	public void eliminar(Pelicula pelicula) {
		contenido.remove(pelicula);
	}
	
	public Pelicula buscarPorPelicula(String titulo) {
//		for (Pelicula pelicula : contenido) {
//			if (pelicula.getTitulo().equalsIgnoreCase(titulo)) {
//				return pelicula;
//			}
//		}
		
		return contenido.stream()
				 .filter(Pelicula -> Pelicula.getTitulo().equalsIgnoreCase(titulo))
				 .findFirst()
				 .orElse(null);
		
//		return null;
	}
	
	public List<Pelicula> buscarPorGenero(String genero) {
		return contenido
						.stream()
						.filter(Pelicula -> Pelicula.getGenero().equalsIgnoreCase(genero))
						.toList();
	}
	
	public List<Pelicula> getPopuplares() {
		return contenido.stream().sorted(Comparator.comparingDouble(Pelicula::getCalificacion)).toList();
	}
	
	public int getDuracionTotal() {
		return contenido
						.stream()
						.mapToInt(Pelicula::getDuracion)
						.sum();
	}
	
	public List<Pelicula> getContenido() {
		return contenido;
	}
	
	public String getNombre() {
		return nombre;
	}
}















 